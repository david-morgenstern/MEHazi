# .env is versioned on purpose: it carries the development defaults, so the
# stacks come up on a fresh clone with nothing to fill in.

.idea/
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Parquet from a local (non-compose) run of task2; the compose stack keeps its
# own in a volume.
output/

# task3's front end, from a local `npm install` / `npm run build`. The image
# builds both itself, from the lockfile, in its node stage.
node_modules/
dist/
