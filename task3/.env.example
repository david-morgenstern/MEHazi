# Copy to .env and edit. Every value here is also the default in compose.yaml,
# so the stack runs without a .env at all. PROXY is the one setting that belongs
# to the machine rather than to the project, and is handled as described below.

# Leave this empty. build-all.sh probes the network and supplies it only on a
# machine that turns out to need one, so the same checkout builds at home and
# behind a corporate proxy without being edited either way. Wanted while
# building and no later — npm and pip are the two things that fetch anything.
# Set it by hand only for a bare `docker compose`, or to overrule the probe:
#   PROXY=http://host.docker.internal:3128
PROXY=

# Where the browser reaches the app.
API_PORT=8000

# task2's database, as it is named inside task2's network. These must match
# task2/.env if you changed them there.
POSTGRES_DB=sensors
POSTGRES_USER=sensors
POSTGRES_PASSWORD=sensors
PGHOST=db
PGPORT=5432

# The network task2's compose created. Only change this if you ran task2 under
# a different project name.
TASK2_NETWORK=mehazi-task2_default
