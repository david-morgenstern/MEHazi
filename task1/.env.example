# Copy to .env and adjust. Local-development credentials — Superset is
# published on your LAN, so change them before this goes anywhere real.
#
#   cp .env.example .env
#   sed -i "s|^SUPERSET_SECRET_KEY=.*|SUPERSET_SECRET_KEY=$(openssl rand -base64 42)|" .env

# --- database layer --------------------------------------------------------
# The superuser, used for the bootstrap only; neither app logs in with it.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

# The data: the backend writes it, Superset reads it.
ANALYTICS_DB=analytics
ANALYTICS_USER=analytics
ANALYTICS_PASSWORD=analytics

# Superset's own dashboards, charts and users — kept apart from the data so
# resetting one never disturbs the other.
SUPERSET_DB=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=superset

# --- ui layer --------------------------------------------------------------
# The only published port. Colleagues reach it at http://<your-hostname>:8088
SUPERSET_HOST_PORT=8088

# Superset refuses to start on the default key. Generate your own:
#   openssl rand -base64 42
SUPERSET_SECRET_KEY=replace-me

# Created on first start, so there is no setup wizard.
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com

# --- backend layer ---------------------------------------------------------
TICKERS=TSM,NVDA,MU,ASML,TSLA
PERIOD=5y
INTERVAL=1d

# --- network ---------------------------------------------------------------
# Leave this empty. build-all.sh probes the network and supplies it only on a
# machine that turns out to need one, so the same checkout builds at home and
# behind a corporate proxy without being edited either way. Wanted for the
# image builds and for the backend's calls to yfinance. Set it by hand only for
# a bare `docker compose`, or to overrule the probe:
#   PROXY=http://host.docker.internal:3128
PROXY=
