# Copy to .env and edit. Every value here is also the default in compose.yaml,
# so the stack runs without a .env at all -- this file is for changing things,
# not for making it work.

# The database, and the port it answers on from the host. Not 5432: that one is
# task1's.
POSTGRES_DB=sensors
POSTGRES_USER=sensors
POSTGRES_PASSWORD=sensors
DB_PORT=5433

# How many readings to generate. A million takes about fifteen seconds on four
# cores; ten million works the same way and takes proportionally longer.
NUM_ROWS=1000000
